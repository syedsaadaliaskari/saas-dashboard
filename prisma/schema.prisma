generator client {
 provider = "prisma-client-js"
 output   = "../app/generated/prisma"
}

datasource db {
 provider = "sqlite"
}

enum Role {
 ADMIN
 USER
}

model User {
 id        String   @id @default(cuid())
 name      String
 email     String
 tenantId  String
 tenant    Tenant   @relation(fields: [tenantId], references: [id])
 role      Role     @default(USER)
 createdAt DateTime @default(now())
}

model Tenant {
 id        String   @id @default(cuid())
 name      String
 createdAt DateTime @default(now())
 users     User[]
}
